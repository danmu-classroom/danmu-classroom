{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "danmu-classroom",
  // Not a secret; lets CI deploy with just CLOUDFLARE_API_TOKEN
  "account_id": "c74b247e8c747f6ca397cca820da6319",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Built by `pnpm build:client` (browser screen script + font); other paths go to the Worker
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "danmu-classroom",
      "database_id": "e83e2b68-004e-4747-ab6e-39cb85090b5e",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
}
