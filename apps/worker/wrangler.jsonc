{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "danmu-classroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Built by `pnpm build:client` (browser screen script + font); other paths go to the Worker
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "danmu-classroom",
      // Replaced by the real id from `wrangler d1 create danmu-classroom` before the first deploy (M5)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
}
